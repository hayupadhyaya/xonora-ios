    "This album will be permanently removed from your library and cannot be recovered." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتم إزالة هذا الألبوم نهائياً من مكتبتك ولا يمكن استعادته."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aquest àlbum s'eliminarà permanentment de la vostra biblioteca i no es pot recuperar."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto album bude trvale odstraněno z vaší knihovny a nelze jej obnovit."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette album fjernes permanent fra dit bibliotek og kan ikke gendannes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Album wird dauerhaft aus deiner Mediathek entfernt und kann nicht wiederhergestellt werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό το άλμπουμ θα αφαιρεθεί μόνιμα από τη βιβλιοθήκη σας και δεν μπορεί να ανακτηθεί."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este álbum se eliminará permanentemente de tu biblioteca y no se podrá recuperar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä albumi poistetaan pysyvästi kirjastostasi, eikä sitä voi palauttaa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet album sera définitivement supprimé de votre bibliothèque et ne pourra pas être récupéré."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אלבום זה יוסר לצמיתות מהספרייה שלך ולא ניתן יהיה לשחזרו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह एल्बम आपकी लाइब्रेरी से स्थायी रूप से हटा दिया जाएगा और इसे वापस नहीं पाया जा सकता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovaj će album biti trajno uklonjen iz vaše biblioteke i ne može se vratiti."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az album véglegesen törlődik a könyvtárból, és nem állítható vissza."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Album ini akan dihapus secara permanen dari perpustakaan Anda dan tidak dapat dipulihkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo album verrà rimosso permanentemente dalla tua libreria e non potrà essere recuperato."
          }
