    "Adjust if lyrics appear too early (negative) or too late (positive) compared to audio." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضبط إذا كانت كلمات الأغاني تظهر مبكرًا جدًا (سالب) أو متأخرًا جدًا (موجب) مقارنة بالصوت."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajusteu si la lletra apareix massa d'hora (negatiu) o massa tard (positiu) en comparació amb l'àudio."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upravte, pokud se texty objevují příliš brzy (záporné) nebo příliš pozdě (kladné) ve srovnání se zvukem."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juster hvis sangtekster vises for tidligt (negativ) eller for sent (positiv) i forhold til lyden."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anpassen, wenn der Songtext im Vergleich zum Audio zu früh (negativ) oder zu spät (positiv) erscheint."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Προσαρμόστε εάν οι στίχοι εμφανίζονται πολύ νωρίς (αρνητικό) ή πολύ αργά (θετικό) σε σύγκριση με τον ήχο."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustar si la letra aparece demasiado pronto (negativo) o demasiado tarde (positivo) en comparación con el audio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Säädä, jos sanoitukset ilmestyvät liian aikaisin (negatiivinen) tai liian myöhään (positiivinen) verrattuna ääneen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustez si les paroles apparaissent trop tôt (négatif) ou trop tard (positif) par rapport à l'audio."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כוונן אם המילים מופיעות מוקדם מדי (שלילי) או מאוחר מדי (חיובי) בהשוואה לאודיו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यदि बोल ऑडियो की तुलना में बहुत पहले (नकारात्मक) या बहुत देर से (सकारात्मक) दिखाई देते हैं तो समायोजित करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podesite ako se tekst pojavljuje prerano (negativno) ili prekasno (pozitivno) u usporedbi sa zvukom."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Állítsa be, ha a szöveg túl korán (negatív) vagy túl későn (pozitív) jelenik meg a hanghoz képest."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sesuaikan jika lirik muncul terlalu cepat (negatif) atau terlalu lambat (positif) dibandingkan audio."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Regola se i testi appaiono troppo presto (negativo) o troppo tardi (positivo) rispetto all'audio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オーディオに対して歌詞が早すぎる場合はマイナス、遅すぎる場合はプラスで調整します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오디오에 비해 가사가 너무 빨리 나오면 음수(-), 너무 늦게 나오면 양수(+)로 조정하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laraskan jika lirik muncul terlalu awal (negatif) atau terlalu lewat (positif) berbanding audio."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Juster hvis sangteksten vises for tidlig (negativ) eller for sent (positiv) i forhold til lyden."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas aan als songteksten te vroeg (negatief) of te laat (positief) verschijnen ten opzichte van de audio."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostosuj, jeśli tekst pojawia się za wcześnie (wartość ujemna) lub za późno (wartość dodatnia) w stosunku do dźwięku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste se a letra aparecer muito cedo (negativo) ou muito tarde (positivo) em comparação com o áudio."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuste se as letras aparecerem muito cedo (negativo) ou muito tarde (positivo) em relação ao áudio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajustează dacă versurile apar prea devreme (negativ) sau prea târziu (pozitiv) față de audio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отрегулируйте, если текст появляется слишком рано (отрицательное значение) или слишком поздно (положительное) по сравнению с аудио."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Upravte, ak sa texty objavujú príliš skoro (záporné) alebo príliš neskoro (kladné) v porovnaní so zvukom."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Justera om låttexten visas för tidigt (negativt) eller för sent (positivt) jämfört med ljudet."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ปรับหากเนื้อเพลงปรากฏเร็วเกินไป (ค่าลบ) หรือช้าเกินไป (ค่าบวก) เมื่อเทียบกับเสียง"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Şarkı sözleri sese göre çok erken (negatif) veya çok geç (pozitif) görünüyorsa ayarlayın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаштуйте, якщо текст з'являється занадто рано (негативне значення) або занадто пізно (позитивне значення) відносно звуку."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều chỉnh nếu lời bài hát xuất hiện quá sớm (âm) hoặc quá muộn (dương) so với âm thanh."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果歌词相对于音频出现得太早（负数）或太晚（正数），请进行调整。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果歌詞相對於音訊出現得太早（負數）或太晚（正數），請進行調整。"
          }
        }
      }
    },
