        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para reordenar as secções. Alterne para mostrar ou ocultar secções no separador Início."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trage pentru a reordona secțiunile. Comută pentru a afișa sau ascunde secțiunile pe fila Acasă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите, чтобы изменить порядок разделов. Используйте переключатель, чтобы показать или скрыть разделы на вкладке «Главная»."
