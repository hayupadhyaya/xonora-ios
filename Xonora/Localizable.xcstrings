    "This will clear all cached images and metadata. The app will re-download content as needed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي هذا إلى مسح جميع الصور والبيانات الوصفية المخزنة مؤقتاً. سيقوم التطبيق بإعادة تحميل المحتوى حسب الحاجة."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això netejarà totes les imatges i metadades emmagatzemades a la memòria cau. L'aplicació tornarà a baixar el contingut segons sigui necessari."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tímto vymažete všechny uložené obrázky a metadata. Aplikace si obsah znovu stáhne podle potřeby."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette vil rydde alle cachede billeder og metadata. Appen vil genindlæse indhold efter behov."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies löscht alle zwischengespeicherten Bilder und Metadaten. Die App wird Inhalte bei Bedarf erneut herunterladen."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό θα καθαρίσει όλες τις αποθηκευμένες εικόνες και τα μεταδεδομένα. Η εφαρμογή θα κατεβάσει ξανά περιεχόμενο όπως απαιτείται."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto borrará todas las imágenes y metadatos en caché. La aplicación volverá a descargar el contenido según sea necesario."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä tyhjentää kaikki välimuistissa olevat kuvat ja metatiedot. Sovellus lataa sisällön uudelleen tarvittaessa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela effacera toutes les images et métadonnées en cache. L'application téléchargera à nouveau le contenu si nécessaire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעולה זו תנקה את כל התמונות והמטא-דאטה שבמטמון. האפליקציה תוריד מחדש את התוכן לפי הצורך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यह सभी कैश की गई छवियों और मेटाडेटा को साफ़ कर देगा। आवश्यकतानुसार ऐप सामग्री को फिर से डाउनलोड करेगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
