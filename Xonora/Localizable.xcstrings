    "\"%@\" doesn't appear on any other albums" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يظهر \"%@\" في أي ألبومات أخرى"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" no apareix en cap altre àlbum"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" se neobjevuje na žádných jiných albech"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" findes ikke på andre album"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" erscheint auf keinen anderen Alben"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το \"%@\" δεν εμφανίζεται σε κανένα άλλο άλμπουμ"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" no aparece en ningún otro álbum"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" ei esiinny muilla albumeilla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" n'apparaît sur aucun autre album"
          }
        },
