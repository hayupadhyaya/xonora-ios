    "Enter the full URL including port number. Access tokens can be generated in Music Assistant settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل العنوان الكامل بما في ذلك رقم المنفذ. يمكن إنشاء رموز الوصول في إعدادات Music Assistant."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduïu l'URL complet, inclòs el número de port. Els tokens d'accés es poden generar a la configuració de Music Assistant."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zadejte celou URL včetně čísla portu. Přístupové tokeny lze vygenerovat v nastavení Music Assistant."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indtast den fulde URL inklusiv portnummer. Adgangstokens kan genereres i indstillingerne for Music Assistant."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geben Sie die vollständige URL einschließlich Portnummer ein. Zugriffs-Token können in den Music Assistant Einstellungen generiert werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εισαγάγετε την πλήρη διεύθυνση URL συμπεριλαμβανομένου του αριθμού θύρας. Τα διακριτικά πρόσβασης μπορούν να δημιουργηθούν στις ρυθμίσεις του Music Assistant."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce la URL completa incluyendo el número de puerto. Los tokens de acceso se pueden generar en los ajustes de Music Assistant."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Syötä täydellinen URL-osoite porttinumeroineen. Pääsyavaimia voi luoda Music Assistantin asetuksissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrez l'URL complète, y compris le numéro de port. Les jetons d'accès peuvent être générés dans les paramètres de Music Assistant."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "הזן את ה-URL המלא כולל מספר פורט. ניתן להפיק אסימוני גישה בהגדרות Music Assistant."
          }
        },
        "hi" : {
