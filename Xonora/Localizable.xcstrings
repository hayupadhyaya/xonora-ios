    "Number of other players tracked simultaneously. Higher values use more memory." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدد المشغلات الأخرى التي يتم تعقبها في وقت واحد. القيم الأعلى تستخدم ذاكرة أكبر."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre d'altres reproductors seguits simultàniament. Els valors més alts utilitzen més memòria."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počet dalších přehrávačů sledovaných současně. Vyšší hodnoty využívají více paměti."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antal andre afspillere sporet samtidigt. Højere værdier bruger mere hukommelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anzahl der gleichzeitig verfolgten anderen Player. Höhere Werte verbrauchen mehr Speicher."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αριθμός άλλων προγραμμάτων αναπαραγωγής που παρακολουθούνται ταυτόχρονα. Οι υψηλότερες τιμές χρησιμοποιούν περισσότερη μνήμη."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de otros reproductores rastreados simultáneamente. Valores más altos usan más memoria."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samanaikaisesti seurattavien muiden soitinten määrä. Suuremmat arvot kuluttavat enemmän muistia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre d'autres lecteurs suivis simultanément. Des valeurs plus élevées utilisent plus de mémoire."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מספר נגנים אחרים שעוקבים אחריהם בו זמנית. ערכים גבוהים יותר משתמשים ביותר זיכרון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक साथ ट्रैक किए गए अन्य प्लेयर की संख्या। उच्च मान अधिक मेमोरी का उपयोग करते हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Broj drugih svirača koji se prate istovremeno. Veće vrijednosti troše više memorije."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az egyszerre követett lejátszók száma. A magasabb értékek több memóriát fogyasztanak."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumlah pemutar lain yang dilacak secara bersamaan. Nilai yang lebih tinggi menggunakan lebih banyak memori."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numero di altri lettori tracciati simultaneamente. Valori più alti utilizzano più memoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同時に追跡する他のプレイヤーの数。値が高いほどメモリを多く使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동시에 추적되는 다른 플레이어의 수입니다. 값이 높을수록 메모리를 더 많이 사용합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bilangan pemain lain yang dijejaki serentak. Nilai yang lebih tinggi menggunakan lebih banyak memori."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antall andre spillere som spores samtidig. Høyere verdier bruker mer minne."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aantal andere spelers dat tegelijkertijd gevolgd wordt. Hogere waarden gebruiken meer geheugen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liczba innych odtwarzaczy śledzonych jednocześnie. Wyższe wartości zużywają więcej pamięci."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de outros players rastreados simultaneamente. Valores mais altos usam mais memória."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Número de outros reprodutores seguidos simultaneamente. Valores mais altos utilizam mais memória."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numărul de alte playere urmărite simultan. Valorile mai mari consumă mai multă memorie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Количество других плееров, отслеживаемых одновременно. Высокие значения требуют больше памяти."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Počet iných prehrávačov sledovaných súčasne. Vyššie hodnoty využívajú viac pamäte."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Antal andra spelare som spåras samtidigt. Högre värden använder mer minne."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "จำนวนเครื่องเล่นอื่นที่ติดตามพร้อมกัน ค่าที่สูงขึ้นจะใช้หน่วยความจำมากขึ้น"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aynı anda takip edilen diğer oynatıcıların sayısı. Daha yüksek değerler daha fazla bellek kullanır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кількість інших плеєрів, що відстежуються одночасно. Вищі значення споживають більше пам'яті."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Số lượng trình phát khác được theo dõi đồng thời. Giá trị cao hơn sẽ sử dụng nhiều bộ nhớ hơn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同时跟踪的其他播放器数量。值越高占用内存越多。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "同時追蹤的其他播放器數量。值越高佔用記憶體越多。"
          }
        }
      }
    },
