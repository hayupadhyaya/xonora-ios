    "Enable to receive audio streams via Sendspin on the same server." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمكينه لاستقبال تدفقات الصوت عبر Sendspin على نفس الخادم."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Activeu-ho per rebre fluxos d'àudio mitjançant Sendspin al mateix servidor."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povolit příjem zvukových streamů přes Sendspin na stejném serveru."
          }
        },
        "da" : {
          "stringUnit" : {
