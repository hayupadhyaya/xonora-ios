          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra för att ändra ordning på sektioner. Växla för att visa eller dölja sektioner på hemfliken."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลากเพื่อเปลี่ยนลำดับส่วน สลับเพื่อแสดงหรือซ่อนส่วนในแท็บหน้าหลัก"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bölümleri yeniden sıralamak için sürükleyin. Ana Sayfa sekmesinde bölümleri göstermek veya gizlemek için değiştirin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетягніть, щоб змінити порядок розділів. Увімкніть або вимкніть, щоб показати або приховати розділи на вкладці Головна."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo để sắp xếp lại các mục. Bật tắt để hiển thị hoặc ẩn các mục trên tab Trang chủ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动以重排各部分。切换开关以在“主页”标签页上显示或隐藏各部分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
