          }
        }
      }
    },
    "Drag to reorder. Tabs with no available content are hidden automatically. Toggle on to always show. At least 2 tabs must be enabled." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب لإعادة الترتيب. يتم إخفاء علامات التبويب التي لا تحتوي على محتوى متاح تلقائيًا. قم بالتشغيل لإظهارها دائمًا. يجب تمكين علامتي تبويب على الأقل."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrossegueu per reordenar. Les pestanyes sense contingut disponible s'amaguen automàticament. Activeu-ho per mostrar-les sempre. S'han d'activar almenys 2 pestanyes."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tažením změníte pořadí. Karty bez dostupného obsahu se skryjí automaticky. Přepnutím je zobrazíte vždy. Musí být povoleny alespoň 2 karty."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk for at omrokere. Faner uden indhold skjules automatisk. Slå til for altid at vise. Mindst 2 faner skal være aktiveret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen, um neu zu ordnen. Tabs ohne verfügbaren Inhalt werden automatisch ausgeblendet. Einschalten, um immer anzuzeigen. Mindestens 2 Tabs müssen aktiviert sein."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε για αναδιάταξη. Οι καρτέλες χωρίς διαθέσιμο περιεχόμενο αποκρύπτονται αυτόματα. Ενεργοποιήστε για να εμφανίζονται πάντα. Πρέπει να είναι ενεργοποιημένες τουλάχιστον 2 καρτέλες."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para reordenar. Las pestañas sin contenido disponible se ocultan automáticamente. Activa para mostrar siempre. Se deben activar al menos 2 pestañas."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedä muuttaaksesi järjestystä. Välilehdet, joilla ei ole sisältöä, piilotetaan automaattisesti. Kytke päälle näyttääksesi aina. Vähintään kaksi välilehteä on oltava käytössä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour réorganiser. Les onglets sans contenu disponible sont masqués automatiquement. Activez pour toujours les afficher. Au moins 2 onglets doivent être activés."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גרור לשינוי סדר. לשוניות ללא תוכן זמין מוסתרות אוטומטית. שנה להצגה תמידית. לפחות 2 לשוניות חייבות להיות מופעלות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "पुनर्व्यवस्थित करने के लिए खींचें। बिना उपलब्ध सामग्री वाले टैब स्वचालित रूप से छिप जाते हैं। हमेशा दिखाने के लिए टॉगल चालू करें। कम से कम 2 टैब सक्षम होने चाहिए।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povucite za promjenu redoslijeda. Kartice bez dostupnog sadržaja automatski se skrivaju. Uključite za stalni prikaz. Moraju biti omogućene barem 2 kartice."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Húzza az átrendezéshez. A tartalom nélküli fülek automatikusan rejtettek. Kapcsolja be a folyamatos megjelenítéshez. Legalább 2 fülnek engedélyezve kell lennie."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarik untuk mengatur ulang. Tab tanpa konten yang tersedia disembunyikan secara otomatis. Aktifkan untuk selalu menampilkan. Minimal 2 tab harus diaktifkan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per riordinare. Le schede senza contenuto disponibile vengono nascoste automaticamente. Attiva per mostrare sempre. Devono essere abilitate almeno 2 schede."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグして並べ替えます。コンテンツがないタブは自動的に非表示になります。常に表示するにはオンにしてください。少なくとも2つのタブを有効にする必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그하여 순서를 바꿉니다. 콘텐츠가 없는 탭은 자동으로 숨겨집니다. 항상 표시하려면 켜세요. 최소 2개의 탭이 활성화되어야 합니다."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret untuk menyusun semula. Tab tanpa kandungan tersedia disembunyikan secara automatik. Togol untuk sentiasa tunjuk. Sekurang-kurangnya 2 tab mesti didayakan."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra for å endre rekkefølge. Faner uten innhold skjules automatisk. Slå på for å alltid vise. Minst 2 faner må være aktivert."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sleep om te herordenen. Tabbladen zonder inhoud worden automatisch verborgen. Schakel in om altijd te tonen. Er moeten minimaal 2 tabbladen ingeschakeld zijn."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przeciągnij, aby zmienić kolejność. Karty bez dostępnej zawartości są ukrywane automatycznie. Włącz, aby zawsze pokazywać. Muszą być włączone co najmniej 2 karty."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para reordenar. Abas sem conteúdo disponível são ocultadas automaticamente. Ative para sempre mostrar. Pelo menos 2 abas devem estar ativadas."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para reordenar. Os separadores sem conteúdo disponível são ocultados automaticamente. Ative para mostrar sempre. Pelo menos 2 separadores devem estar ativados."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trage pentru a reordona. Filele fără conținut disponibil sunt ascunse automat. Comută pentru a afișa mereu. Cel puțin 2 file trebuie activate."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетащите, чтобы изменить порядок. Вкладки без контента скрываются автоматически. Включите, чтобы показывать всегда. Должно быть включено не менее 2 вкладок."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potiahnutím zmeníte poradie. Karty bez dostupného obsahu sa skryjú automaticky. Prepnutím ich zobrazíte vždy. Musia byť povolené aspoň 2 karty."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dra för att ändra ordning. Flikar utan tillgängligt innehåll döljs automatiskt. Växla på för att alltid visa. Minst 2 flikar måste vara aktiverade."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ลากเพื่อเปลี่ยนลำดับ แท็บที่ไม่มีเนื้อหาจะถูกซ่อนโดยอัตโนมัติ สลับเพื่อแสดงเสมอ ต้องเปิดใช้งานอย่างน้อย 2 แท็บ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeniden sıralamak için sürükleyin. İçeriği olmayan sekmeler otomatik olarak gizlenir. Her zaman göstermek için açın. En az 2 sekme etkinleştirilmelidir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перетягніть, щоб змінити порядок. Вкладки без доступного вмісту приховуються автоматично. Увімкніть, щоб показувати завжди. Потрібно ввімкнути принаймні 2 вкладки."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kéo để sắp xếp lại. Các tab không có nội dung sẽ tự động bị ẩn. Bật để luôn hiển thị. Phải bật ít nhất 2 tab."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动以重排。没有可用内容的标签页会自动隐藏。开启开关以始终显示。必须启用至少 2 个标签页。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖動以重排。沒有可用內容的標籤頁會自動隱藏。開啟開關以始終顯示。必須啟用至少 2 個標籤頁。"
          }
        }
      }
    },
