    "Drag to reorder sections. Toggle to show or hide sections on the Home tab." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب لإعادة ترتيب الأقسام. قم بالتبديل لإظهار أو إخفاء الأقسام في علامة تبويب الصفحة الرئيسية."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrossegueu per reordenar les seccions. Commuteu per mostrar o amagar les seccions a la pestanya d'Inici."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tažením změníte pořadí sekcí. Přepnutím zobrazíte nebo skryjete sekce na kartě Domů."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Træk for at omrokere sektioner. Skift for at vise eller skjule sektioner på fanen Hjem."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziehen, um Abschnitte neu zu ordnen. Schalten, um Abschnitte auf dem Home-Tab anzuzeigen oder auszublenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Σύρετε για αναδιάταξη ενοτήτων. Εναλλαγή για εμφάνιση ή απόκρυψη ενοτήτων στην καρτέλα Αρχική."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para reordenar las secciones. Activa o desactiva para mostrar u ocultar secciones en la pestaña de inicio."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedä muuttaaksesi osioiden järjestystä. Vaihda näyttääksesi tai piilottaaksesi osiot Koti-välilehdellä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites glisser pour réorganiser les sections. Basculez pour afficher ou masquer les sections sur l'onglet Accueil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "גרור לשינוי סדר הסעיפים. שנה כדי להציג או להסתיר סעיפים בלשונית הבית."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अनुभागों को पुनर्व्यवस्थित करने के लिए खींचें। होम टैब पर अनुभागों को दिखाने या छिपाने के लिए टॉगल करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Povucite za promjenu redoslijeda odjeljaka. Uključite ili isključite za prikaz ili skrivanje odjeljaka na kartici Početna."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Húzza a szakaszok átrendezéséhez. Kapcsolja be vagy ki a szakaszok megjelenítését a Főoldal fülön."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarik untuk mengatur ulang bagian. Aktifkan untuk menampilkan atau menyembunyikan bagian pada tab Beranda."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per riordinare le sezioni. Attiva/disattiva per mostrare o nascondere le sezioni nella scheda Home."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグしてセクションを並べ替えます。ホームタブのセクションの表示/非表示を切り替えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "드래그하여 섹션 순서를 바꿉니다. 홈 탭에서 섹션을 표시하거나 숨기려면 토글하세요."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seret untuk menyusun semula bahagian. Togol untuk tunjuk atau sembunyi bahagian pada tab Laman Utama."
          }
        },
        "nb" : {
          "stringUnit" : {
